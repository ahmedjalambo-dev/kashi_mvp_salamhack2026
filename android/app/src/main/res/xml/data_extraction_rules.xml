<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud-backup and device-transfer rules -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="kashi.db"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="kashi.db"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </device-transfer>
</data-extraction-rules>
