n/* greek */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"df2eae7f-190a-4fe8-a0fc-2e9dd73f8e43\") format('woff2');\n  unicode-range: U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"91182741-d3a7-4062-a015-a24a89bd0bb8\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"385a11d6-d938-4427-a4b5-18b5587ca464\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"ba0fbe3a-9ba9-4222-85b3-9fe8b07dacc3\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n\n:root {\n  /* ---------- Brand colors ---------- */\n  --kashi-olive: #2D5F3F;          /* Primary — deep olive */\n  --kashi-olive-700: #234B32;      /* Pressed / darker */\n  --kashi-olive-300: #6B9B7C;      /* Light olive for backgrounds */\n  --kashi-olive-50:  #EAF2EC;      /* Tint — banners, soft fills */\n\n  --kashi-terracotta: #C76F3F;     /* Secondary — warm earth */\n  --kashi-terracotta-700: #A4582E;\n  --kashi-terracotta-50:  #FBEFE6;\n\n  --kashi-gold: #D4A24C;           /* Accent — premium, key actions */\n  --kashi-gold-700: #B0833A;\n  --kashi-gold-50:  #FBF3E1;\n\n  /* ---------- Semantic ---------- */\n  --color-success: #4CAF50;\n  --color-success-bg: #E8F5E9;\n  --color-warning: #FF9800;\n  --color-warning-bg: #FFF4E5;\n  --color-error: #E53935;\n  --color-error-bg: #FCEAEA;\n  --color-info: #2D5F3F;          /* Reuse olive for info */\n  --color-info-bg: #EAF2EC;\n\n  /* ---------- Neutrals (light) ---------- */\n  --bg:           #FAF8F5;        /* Page background — warm off-white */\n  --surface:      #FFFFFF;        /* Cards, sheets */\n  --surface-2:    #F4F1EB;        /* Sunken / inset surfaces */\n  --fg:           #1A1A1A;        /* Primary text */\n  --fg-2:         #6B6B6B;        /* Secondary text */\n  --fg-3:         #9A9A9A;        /* Tertiary / disabled */\n  --border:       #E8E5E0;        /* Hairlines */\n  --border-strong:#D4CFC6;\n  --scrim:        rgba(15, 22, 18, 0.5);\n\n  /* ---------- Type ---------- */\n  --font-en:    'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  --font-ar:    'IBM Plex Sans Arabic', 'Tajawal', 'Inter', sans-serif;\n  --font-mono:  'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;\n\n  /* Type scale (English baseline; Arabic is sized +1–2px optically) */\n  --fs-display:   48px;\n  --fs-h1:        32px;\n  --fs-h2:        24px;\n  --fs-h3:        20px;\n  --fs-body:      16px;\n  --fs-caption:   14px;\n  --fs-micro:     12px;\n\n  --lh-display: 1.1;\n  --lh-heading: 1.25;\n  --lh-body:    1.5;\n\n  --fw-regular: 400;\n  --fw-medium:  500;\n  --fw-semibold:600;\n  --fw-bold:    700;\n\n  /* Tabular figures everywhere we render numbers */\n  --num-feat: \"tnum\" 1, \"lnum\" 1;\n\n  /* ---------- Spacing (8px grid) ---------- */\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-8: 32px;\n  --space-10: 40px;\n  --space-12: 48px;\n  --space-16: 64px;\n\n  /* ---------- Radii ---------- */\n  --r-input:   12px;\n  --r-card:    16px;\n  --r-button:  24px;\n  --r-balance: 24px;\n  --r-pill:    999px;\n\n  /* ---------- Shadows (subtle, never heavy) ---------- */\n  --shadow-sm:      0 1px 2px rgba(26,26,26,0.04);\n  --shadow-md:      0 4px 12px rgba(26,26,26,0.06);\n  --shadow-lg:      0 12px 32px rgba(26,26,26,0.08);\n  --shadow-balance: 0 8px 24px rgba(45,95,63,0.18);\n  --shadow-focus:   0 0 0 2px var(--bg), 0 0 0 4px var(--kashi-olive);\n\n  /* ---------- Motion ---------- */\n  --ease-standard: cubic-bezier(0.4, 0.0, 0.2, 1);\n  --ease-expo-out: cubic-bezier(0.16, 1, 0.3, 1);\n  --dur-fast:    150ms;\n  --dur-medium:  250ms;\n  --dur-slow:    600ms;\n\n  /* ---------- Layout ---------- */\n  --touch-min: 48px;       /* WCAG / brief minimum */\n  --nav-height: 72px;\n}\n\n/* ---------------- Dark mode ---------------- */\n:root[data-theme=\"dark\"], .theme-dark {\n  --kashi-olive:     #4A8A65;\n  --kashi-olive-700: #3D7355;\n  --kashi-olive-300: #6FAE8A;\n  --kashi-olive-50:  #1F2E26;\n\n  --kashi-terracotta-50: #2A1F18;\n  --kashi-gold-50:       #2B2418;\n\n  --bg:            #0F1612;\n  --surface:       #1A2620;\n  --surface-2:     #243029;\n  --fg:            #F5F2EC;\n  --fg-2:          #A9B0AB;\n  --fg-3:          #6E7670;\n  --border:        #2C3A33;\n  --border-strong: #3C4B43;\n  --scrim:         rgba(0, 0, 0, 0.6);\n\n  --color-success-bg: #16291A;\n  --color-warning-bg: #2B1F0F;\n  --color-error-bg:   #2B1414;\n  --color-info-bg:    #1F2E26;\n\n  --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);\n  --shadow-md: 0 4px 12px rgba(0,0,0,0.35);\n  --shadow-lg: 0 12px 32px rgba(0,0,0,0.45);\n  --shadow-balance: 0 8px 24px rgba(0,0,0,0.5);\n}\n\n/* =====================================================================\n   Base + semantic element styles\n   ===================================================================== */\n\nhtml, body {\n  margin: 0;\n  background: var(--bg);\n  color: var(--fg);\n  font-family: var(--font-en);\n  font-size: var(--fs-body);\n  line-height: var(--lh-body);\n  font-feature-settings: var(--num-feat);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n[dir=\"rtl\"], .lang-ar { font-family: var(--font-ar); }\n\nh1, .h1 { font-size: var(--fs-h1); line-height: var(--lh-heading); font-weight: var(--fw-bold); margin: 0; letter-spacing: -0.01em; }\nh2, .h2 { font-size: var(--fs-h2); line-height: var(--lh-heading); font-weight: var(--fw-semibold); margin: 0; }\nh3, .h3 { font-size: var(--fs-h3); line-height: var(--lh-heading); font-weight: var(--fw-semibold); margin: 0; }\n.display { font-size: var(--fs-display); line-height: var(--lh-display); font-weight: var(--fw-bold); letter-spacing: -0.02em; }\n.body    { font-size: var(--fs-body); line-height: var(--lh-body); font-weight: var(--fw-regular); }\n.caption { font-size: var(--fs-caption); line-height: 1.4; font-weight: var(--fw-medium); color: var(--fg-2); }\n.micro   { font-size: var(--fs-micro); line-height: 1.3; font-weight: var(--fw-medium); color: var(--fg-2); letter-spacing: 0.02em; }\n.mono    { font-family: var(--font-mono); font-feature-settings: var(--num-feat); }\n.num     { font-feature-settings: var(--num-feat); font-variant-numeric: tabular-nums; }\n\n/* =====================================================================\n   Buttons (token-driven so UI kits can compose)\n   ===================================================================== */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-2);\n  min-height: var(--touch-min);\n  padding: 0 var(--space-6);\n  border: none;\n  border-radius: var(--r-button);\n  font-family: inherit;\n  font-size: var(--fs-body);\n  font-weight: var(--fw-semibold);\n  cursor: pointer;\n  transition: transform var(--dur-fast) var(--ease-standard),\n              background var(--dur-fast) var(--ease-standard),\n              opacity var(--dur-fast) var(--ease-standard);\n}\n.btn:active { transform: scale(0.98); opacity: 0.9; }\n.btn:focus-visible { outline: none; box-shadow: var(--shadow-focus); }\n\n.btn-primary   { background: var(--kashi-olive); color: #fff; }\n.btn-primary:hover   { background: var(--kashi-olive-700); }\n.btn-secondary { background: var(--surface); color: var(--fg); border: 1px solid var(--border-strong); }\n.btn-secondary:hover { background: var(--surface-2); }\n.btn-accent    { background: var(--kashi-gold); color: #1A1A1A; }\n.btn-accent:hover    { background: var(--kashi-gold-700); color: #fff; }\n.btn-ghost     { background: transparent; color: var(--kashi-olive); }\n.btn-ghost:hover { background: var(--kashi-olive-50); }\n\n/* =====================================================================\n   Inputs\n   ===================================================================== */\n\n.input {\n  width: 100%;\n  min-height: var(--touch-min);\n  padding: 0 var(--space-4);\n  background: var(--surface);\n  color: var(--fg);\n  border: 1px solid var(--border);\n  border-radius: var(--r-input);\n  font-family: inherit;\n  font-size: var(--fs-body);\n  transition: border-color var(--dur-fast) var(--ease-standard),\n              box-shadow var(--dur-fast) var(--ease-standard);\n}\n.input::placeholder { color: var(--fg-3); }\n.input:focus { outline: none; border-color: var(--kashi-olive); box-shadow: 0 0 0 3px var(--kashi-olive-50); }\n\n/* =====================================================================\n   Cards\n   ===================================================================== */\n\n.card {\n  background: var(--surface);\n  border-radius: var(--r-card);\n  box-shadow: var(--shadow-md);\n  padding: var(--space-5);\n}\n.card-flat { box-shadow: none; border: 1px solid var(--border); }\n\n/* =====================================================================\n   Pills / badges (status: icon + text + color, never color alone)\n   ===================================================================== */\n\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  padding: 4px 10px;\n  border-radius: var(--r-pill);\n  font-size: var(--fs-micro);\n  font-weight: var(--fw-semibold);\n  letter-spacing: 0.02em;\n}\n.badge-success { background: var(--color-success-bg); color: #2E7D32; }\n.badge-warning { background: var(--color-warning-bg); color: #B86E00; }\n.badge-error   { background: var(--color-error-bg);   color: #B71C1C; }\n.badge-info    { background: var(--color-info-bg);    color: var(--kashi-olive); }\n<\u002Fstyle>\n  <style>\n    html, body { margin: 0; padding: 0; background: #F4F1EB; font-family: 'Inter', system-ui, sans-serif; color: #1A1A1A; }\n    * { box-sizing: border-box; }\n    /* The Android device frame around each artboard's contents */\n    .android-frame {\n      width: 412px; height: 812px;\n      border-radius: 44px; padding: 11px; background: #1a1a1a;\n      box-shadow: 0 24px 60px -20px rgba(0,0,0,0.28), 0 0 0 1px rgba(0,0,0,0.06);\n      position: relative;\n    }\n    .android-frame::before {\n      content: \"\"; position: absolute; top: 22px; left: 50%; transform: translateX(-50%);\n      width: 10px; height: 10px; background: #0a0a0a; border-radius: 999px; z-index: 5;\n    }\n    .android-screen {\n      width: 100%; height: 100%; border-radius: 34px; overflow: hidden; background: #FAF8F5;\n      display: flex; flex-direction: column;\n    }\n  <\u002Fstyle>\n<\u002Fhead>\n<body>\n  \n  <div id=\"root\"><\u002Fdiv>\n\n  <script src=\"e0b6da42-c8f4-4bf2-a44f-461051924c1d\" integrity=\"sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L\" crossorigin=\"anonymous\"><\u002Fscript>\n  <script src=\"https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js\" integrity=\"sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm\" crossorigin=\"anonymous\"><\u002Fscript>\n  <script src=\"https://unpkg.com/@babel/standalone@7.29.0/babel.min.js\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"><\u002Fscript>\n\n  <script type=\"text/babel\" src=\"79b84abc-7bd0-4190-aaf8-49d8a21fd589\"><\u002Fscript>\n  <script type=\"text/babel\" src=\"2f12bcfb-4089-4ea9-8e8f-d86ee6017aa6\"><\u002Fscript>\n  <script type=\"text/babel\" src=\"edf1670f-5a62-4bf9-b4b9-45c0526e88c0\"><\u002Fscript>\n  <script type=\"text/babel\" src=\"802444fc-f3eb-49d6-bc2e-72f21d11f416\"><\u002Fscript>\n  <script type=\"text/babel\" src=\"1ddb16d1-d15f-4505-8607-f27bc6265c51\"><\u002Fscript>\n  <script type=\"text/babel\" src=\"3e387614-32e2-42cd-a40e-52fa712a26c4\"><\u002Fscript>\n\n  <script type=\"text/babel\">\n    const { DesignCanvas, DCSection, DCArtboard } = window;\n\n    // Wrap every screen in an Android-style device frame.\n    function Phone({ children }) {\n      return (\n        <div className=\"android-frame\">\n          <div className=\"android-screen\">{children}<\u002Fdiv>\n        <\u002Fdiv>\n      );\n    }\n\n    // DCSection filters children by `c.type === DCArtboard` (component\n    // identity), so the wrapper helper has to *return a DCArtboard element*\n    // and be CALLED at the JSX site (not used as a JSX tag). Hence AB() — a\n    // factory, not a component.\n    const AB = (id, label, children) =>\n      <DCArtboard key={id} id={id} label={label} width={460} height={860}>\n        <div style={{ padding: 24, display: \"grid\", placeItems: \"center\", height: \"100%\" }}>\n          <Phone>{children}<\u002FPhone>\n        <\u002Fdiv>\n      <\u002FDCArtboard>;\n\n    function App() {\n      return (\n        <DesignCanvas>\n          <DCSection id=\"onboarding\" title=\"Onboarding & Auth\" subtitle=\"The first 90 seconds — phone-based signup with auto-issued PS-IBAN.\">\n            {AB(\"01-splash\", \"01 · Splash\", <><ScreenSplash/><\u002F>)}\n            {AB(\"02-phone\", \"02 · Phone login\", <><ScreenPhone/><\u002F>)}\n            {AB(\"03-otp\", \"03 · OTP verify\", <><ScreenOTP/><\u002F>)}\n            {AB(\"04-profile\", \"04 · Profile setup\", <><ScreenProfile/><\u002F>)}\n          <\u002FDCSection>\n\n          <DCSection id=\"home\" title=\"Home\" subtitle=\"Wallet balance is sacred. Three primary actions, recent activity below.\">\n            {AB(\"05-home\", \"05 · Home (online)\", <><ScreenHome sync=\"online\"/><\u002F>)}\n            {AB(\"05b-home-offl\", \"05b · Home (offline)\", <><ScreenHome sync=\"offline\"/><\u002F>)}\n            {AB(\"05c-home-pend\", \"05c · Home (pending)\", <><ScreenHome sync=\"pending\"/><\u002F>)}\n          <\u002FDCSection>\n\n          <DCSection id=\"receive\" title=\"Receive / Top-up\" subtitle=\"Cash in via E-SADAD from any Palestinian bank app.\">\n            {AB(\"06-receive\", \"06 · Receive money\", <><ScreenReceive/><\u002F>)}\n            {AB(\"07-success\", \"07 · Top-up success\", <><ScreenReceiveSuccess/><\u002F>)}\n          <\u002FDCSection>\n\n          <DCSection id=\"send\" title=\"⭐ Offline P2P Send — the hero flow\" subtitle=\"Cryptographically-signed payments that work without network. Treat the QR moment ceremonially.\">\n            {AB(\"08-amount\", \"08 · Amount\", <><ScreenSendAmount offline/><\u002F>)}\n            {AB(\"09-qr\", \"09 · QR display\", <><ScreenSendQR/><\u002F>)}\n            {AB(\"10-bt\", \"10 · Bluetooth radar\", <><ScreenSendBT/><\u002F>)}\n            {AB(\"11-pending\", \"11 · Pending sync\", <><ScreenSendPending/><\u002F>)}\n            {AB(\"12-confirmed\", \"12 · Online confirmed\", <><ScreenSendConfirmed/><\u002F>)}\n          <\u002FDCSection>\n\n          <DCSection id=\"p2pin\" title=\"⭐ Offline P2P Receive\" subtitle=\"Trust moment: verify the signature, accept the payment, settle later.\">\n            {AB(\"13-scan\", \"13 · Scan\", <><ScreenScan/><\u002F>)}\n            {AB(\"14-verify\", \"14 · Verify (trust)\", <><ScreenVerify/><\u002F>)}\n            {AB(\"15-pending\", \"15 · Accepted, pending\", <><ScreenReceivePending/><\u002F>)}\n            {AB(\"16-history\", \"16 · History detail\", <><ScreenHistoryDetail/><\u002F>)}\n          <\u002FDCSection>\n\n          <DCSection id=\"iburaq\" title=\"iBuraq · Outbound bank transfer\" subtitle=\"Lookup any phone, find linked bank accounts and wallets, send.\">\n            {AB(\"17-lookup\", \"17 · Lookup\", <><ScreenLookup/><\u002F>)}\n            {AB(\"18-pick\", \"18 · Pick destination\", <><ScreenDestinations/><\u002F>)}\n            {AB(\"19-confirm\", \"19 · Confirm\", <><ScreenTransferConfirm/><\u002F>)}\n            {AB(\"20-sent\", \"20 · Sent\", <><ScreenTransferSuccess/><\u002F>)}\n          <\u002FDCSection>\n\n          <DCSection id=\"rtl\" title=\"Arabic / RTL — mirrored screens\" subtitle=\"Arabic is the primary locale. Layouts mirror; numerals stay tabular; the wallet card direction flips.\">\n            {AB(\"r1-splash\", \"ar · Splash\", <><ScreenSplash dir=\"rtl\"/><\u002F>)}\n            {AB(\"r2-phone\", \"ar · Phone login\", <><ScreenPhone dir=\"rtl\"/><\u002F>)}\n            {AB(\"r3-home\", \"ar · Home\", <><ScreenHome dir=\"rtl\" sync=\"online\"/><\u002F>)}\n            {AB(\"r4-amount\", \"ar · Send amount\", <><ScreenSendAmount dir=\"rtl\" offline/><\u002F>)}\n            {AB(\"r5-verify\", \"ar · Verify (trust)\", <><ScreenVerify dir=\"rtl\"/><\u002F>)}\n          <\u002FDCSection>\n        <\u002FDesignCanvas>\n      );\n    }\n\n    ReactDOM.createRoot(document.getElementById(\"root\")).render(<App/>);\n  <\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>
</file>

<file path="kashi-design-system/project/preview/colors-brand.html">
<!doctype html>
<html><head><meta charset="utf-8"><title>Brand colors</title>
<link rel="stylesheet" href="../colors_and_type.css">
<style>
